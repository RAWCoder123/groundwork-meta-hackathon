{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "tsc --noEmit && node scripts/run-framework.mjs build",
    "test": "tsx --test tests/*.test.ts",
    "validate": "node scripts/validate-artifact.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "db:generate": "drizzle-kit generate",
    "evaluate:corrections": "tsx scripts/evaluate-corrections.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "suncalc": "^1.9.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
